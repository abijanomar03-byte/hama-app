NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never exposed to the browser. Used by app/api/verify-photo
# to confirm each captured photo actually shows a room/house before it's
# accepted. Get a key at https://console.anthropic.com
# Without this set, photos are still accepted (so posting isn't blocked),
# but the app visibly warns that no content check happened — it never
# silently pretends to have verified anything.
ANTHROPIC_API_KEY=
